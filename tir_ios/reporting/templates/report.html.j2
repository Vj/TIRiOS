<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>TIRiOS VAPT Security Assessment Report - {{ metadata.app_name }}</title>
  <style>
    @page {
      size: A4;
      margin: 18mm 16mm 18mm 16mm;
      @top-left {
        content: "TIRiOS | iOS Mobile Application VAPT Report";
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 8pt;
        color: #64748b;
      }
      @top-right {
        content: "{{ metadata.bundle_id }} (v{{ metadata.bundle_version }})";
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 8pt;
        color: #64748b;
      }
      @bottom-left {
        content: "CONFIDENTIAL — OWASP MASVS v2.0 / MASTG Aligned";
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 8pt;
        color: #64748b;
      }
      @bottom-right {
        content: "Page " counter(page) " of " counter(pages);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 8pt;
        color: #64748b;
      }
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #1e293b;
      font-size: 9.5pt;
      line-height: 1.45;
      margin: 0;
    }

    .cover-banner {
      background: #0f172a;
      color: #f8fafc;
      padding: 22px 24px;
      border-radius: 6px;
      margin-bottom: 18px;
      border-left: 6px solid #38bdf8;
    }

    .cover-banner h1 {
      margin: 0 0 4px 0;
      font-size: 18pt;
      letter-spacing: 0.3px;
    }

    .cover-banner .subtitle {
      color: #94a3b8;
      font-size: 9.5pt;
      margin: 0;
    }

    h2 {
      font-size: 12pt;
      color: #0f172a;
      border-bottom: 1.5px solid #cbd5e1;
      padding-bottom: 4px;
      margin-top: 20px;
      margin-bottom: 10px;
    }

    .meta-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 16px;
      font-size: 9pt;
    }

    .meta-table td {
      padding: 6px 10px;
      border: 1px solid #e2e8f0;
    }

    .meta-table td.label {
      background: #f8fafc;
      font-weight: 600;
      width: 22%;
      color: #475569;
    }

    .kpi-grid {
      display: table;
      width: 100%;
      table-layout: fixed;
      margin-bottom: 16px;
      border-spacing: 8px 0;
    }

    .kpi-card {
      display: table-cell;
      border: 1px solid #e2e8f0;
      border-radius: 5px;
      padding: 10px 8px;
      text-align: center;
      background: #f8fafc;
    }

    .kpi-card .count {
      font-size: 16pt;
      font-weight: 700;
      display: block;
    }

    .kpi-card .lbl {
      font-size: 7.5pt;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .sev-Critical { color: #991b1b; border-top: 3px solid #dc2626; }
    .sev-High     { color: #9a3412; border-top: 3px solid #ea580c; }
    .sev-Medium   { color: #92400e; border-top: 3px solid #d97706; }
    .sev-Low      { color: #1e40af; border-top: 3px solid #2563eb; }
    .sev-Info     { color: #334155; border-top: 3px solid #64748b; }

    .badge {
      display: inline-block;
      padding: 2px 7px;
      border-radius: 3px;
      font-size: 7.5pt;
      font-weight: 700;
      text-transform: uppercase;
      color: #ffffff;
    }

    .badge-Critical { background: #dc2626; }
    .badge-High     { background: #ea580c; }
    .badge-Medium   { background: #d97706; }
    .badge-Low      { background: #2563eb; }
    .badge-Info     { background: #64748b; }

    .summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5pt;
      margin-bottom: 18px;
    }

    .summary-table th {
      background: #0f172a;
      color: #f8fafc;
      text-align: left;
      padding: 6px 8px;
      font-weight: 600;
    }

    .summary-table td {
      padding: 6px 8px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: top;
    }

    .finding-card {
      border: 1px solid #cbd5e1;
      border-radius: 5px;
      margin-bottom: 12px;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .finding-header {
      background: #f1f5f9;
      padding: 7px 10px;
      border-bottom: 1px solid #cbd5e1;
      font-weight: 600;
    }

    .finding-body {
      padding: 8px 10px;
      font-size: 8.8pt;
    }

    .finding-meta {
      color: #475569;
      font-size: 8pt;
      margin-bottom: 6px;
    }

    .code-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-left: 3px solid #475569;
      padding: 5px 8px;
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      font-size: 8pt;
      word-break: break-all;
      margin: 4px 0 6px 0;
    }
  </style>
</head>
<body>

  <div class="cover-banner">
    <h1>TIRiOS Security Assessment Report</h1>
    <p class="subtitle">Automated Static &amp; Dynamic Vulnerability Assessment (OWASP MASVS v2.0 / MASTG)</p>
  </div>

  <h2>1. Target Application &amp; Assessment Metadata</h2>
  <table class="meta-table">
    <tr>
      <td class="label">Application Name</td>
      <td>{{ metadata.app_name }}</td>
      <td class="label">Bundle Identifier</td>
      <td><code>{{ metadata.bundle_id }}</code></td>
    </tr>
    <tr>
      <td class="label">App Version</td>
      <td>{{ metadata.bundle_version }}</td>
      <td class="label">Minimum iOS</td>
      <td>iOS {{ metadata.min_os_version }}</td>
    </tr>
    <tr>
      <td class="label">Architectures</td>
      <td>{{ metadata.architectures | join(", ") if metadata.architectures else "N/A" }}</td>
      <td class="label">Generated At (UTC)</td>
      <td>{{ generated_at }}</td>
    </tr>
  </table>

  <h2>2. Executive Risk Summary</h2>
  <div class="kpi-grid">
    {% for sev in ["Critical", "High", "Medium", "Low", "Info"] %}
    <div class="kpi-card sev-{{ sev }}">
      <span class="count">{{ severity_counts[sev] }}</span>
      <span class="lbl">{{ sev }}</span>
    </div>
    {% endfor %}
  </div>

  {% if findings %}
  <table class="summary-table">
    <thead>
      <tr>
        <th style="width: 15%;">Rule ID</th>
        <th style="width: 10%;">Severity</th>
        <th style="width: 8%;">CVSS</th>
        <th style="width: 18%;">OWASP MASVS</th>
        <th style="width: 49%;">Finding Title</th>
      </tr>
    </thead>
    <tbody>
      {% for f in findings %}
      <tr>
        <td><code>{{ f.finding_id }}</code></td>
        <td><span class="badge badge-{{ f.severity }}">{{ f.severity }}</span></td>
        <td>{{ "%.1f"|format(f.cvss_score) }}</td>
        <td>{{ f.masvs_category }}</td>
        <td>{{ f.title }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>3. Detailed Technical Findings &amp; Remediation</h2>
  {% for f in findings %}
  <div class="finding-card">
    <div class="finding-header">
      <span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>
      &nbsp;<code>{{ f.finding_id }}</code> — {{ f.title }}
    </div>
    <div class="finding-body">
      <div class="finding-meta">
        <strong>Phase:</strong> {{ f.phase }} &nbsp;|&nbsp;
        <strong>CVSS v3.1:</strong> {{ "%.1f"|format(f.cvss_score) }} &nbsp;|&nbsp;
        <strong>MASVS:</strong> {{ f.masvs_category }} &nbsp;|&nbsp;
        <strong>MASTG:</strong> {{ f.mastg_test_id }}
      </div>
      <div class="finding-meta">
        <strong>Confidence:</strong> {{ f.confidence | default("Unassessed") }} &nbsp;|&nbsp;
        <strong>Evidence Source:</strong> {{ f.evidence_source | default("Unspecified") }} &nbsp;|&nbsp;
        <strong>Verification:</strong> {{ f.verification_status | default("Not Verified") }}
      </div>
      <div><strong>Affected Location:</strong> <code>{{ f.location }}</code></div>
      <div class="code-box">{{ f.evidence }}</div>
      <div><strong>Remediation:</strong> {{ f.remediation }}</div>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <p>No security findings were identified across the executed checks.</p>
  {% endif %}

</body>
</html>